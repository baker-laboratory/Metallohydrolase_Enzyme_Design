Bootstrap: docker
From: condaforge/miniforge3:24.9.2-0

%help
    Linux x86_64 helper image for repository scoring and structure preparation.
    Model stacks and checkpoints must be installed separately; see
    Environment/README.md. This is not an RFdiffusion2/3 inference image.

    Build from the repository root (site permissions may require --fakeroot):
        apptainer build Environment/zinc_hydro.sif Environment/zinc_hydro.def

    The runscript is the helper environment's Python:
        apptainer run Environment/zinc_hydro.sif Scripts/env_config.py
        apptainer exec --nv Environment/zinc_hydro.sif python your_gpu_helper.py

    For wrappers that use Scripts/env_config.py:
        export ZINC_HYDRO_SIF=/absolute/path/to/Environment/zinc_hydro.sif

%labels
    Name        zinc_hydro
    Description Linux CUDA helper environment; model stacks installed separately
    Repository  https://github.com/baker-laboratory/Metallohydrolase_Enzyme_Design

%files
    Environment/zinc_hydro.yml /opt/zinc_hydro.yml

%post
    set -eux
    export PATH=/opt/conda/bin:$PATH
    apt-get update -y
    apt-get install -y --no-install-recommends \
        build-essential git wget ca-certificates aria2
    rm -rf /var/lib/apt/lists/*

    # Preserve the package manager's base runtime.
    conda env create -y -f /opt/zinc_hydro.yml
    conda clean -afy

%environment
    export PATH=/opt/conda/envs/zinc_hydro/bin:/opt/conda/bin:$PATH
    export PYTHONNOUSERSITE=1
    export PYTHONPATH=

%runscript
    exec /opt/conda/envs/zinc_hydro/bin/python "$@"

%test
    /opt/conda/envs/zinc_hydro/bin/python -c "import numpy, pandas, scipy, openpyxl, torch, pyrosetta; print('helper imports OK')"
    /opt/conda/envs/zinc_hydro/bin/obabel -V
