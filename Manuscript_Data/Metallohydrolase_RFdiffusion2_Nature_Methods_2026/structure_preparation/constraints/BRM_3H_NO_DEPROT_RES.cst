# cst constraint descriptor for Zn esterase
# with R-7-coumarinyl-1-methyl-1-phenylacetate
# 3HIS, carboxylate general base and two ozyanion hole residues
# I. Kalvet, Baker lab, UW,   ikalvet@uw.edu

# NOTE


#block 1 for His coordinated to Zn

VARIABLE_CST::BEGIN
# HIS coordination
CST::BEGIN

  TEMPLATE::   ATOM_MAP: 1 atom_name: ZN1 O1 C1
  TEMPLATE::   ATOM_MAP: 1 residue3:  BRM

  TEMPLATE::   ATOM_MAP: 2 atom_type: Nhis
  TEMPLATE::   ATOM_MAP: 2 residue3: HIS

  CONSTRAINT:: distanceAB:   2.05   0.02   150.  1    0
  CONSTRAINT::    angle_A:   100.4  2.0   150.0  360. 0
  CONSTRAINT::    angle_B:  127.9  2.0   150.0  360. 0
  CONSTRAINT::  torsion_A:  -153.2  2.0   150.0  360. 0
  CONSTRAINT:: torsion_AB:  56.7  2.0  150.0  180. 0
  CONSTRAINT::  torsion_B:  -173.9  2.0  150.0  360. 0

  ALGORITHM_INFO:: match
   MAX_DUNBRACK_ENERGY 100.0 
  ALGORITHM_INFO::END
CST::END

VARIABLE_CST::END

#block 2 for His coordinated to Zn

VARIABLE_CST::BEGIN
# HIS coordination
CST::BEGIN

  TEMPLATE::   ATOM_MAP: 1 atom_name: ZN1 O1 C1
  TEMPLATE::   ATOM_MAP: 1 residue3:  BRM

  TEMPLATE::   ATOM_MAP: 2 atom_type: Nhis
  TEMPLATE::   ATOM_MAP: 2 residue3: HIS

  CONSTRAINT:: distanceAB:   2.03   0.02   150.  1   0
  CONSTRAINT::    angle_A:  110.02  2.0   150.0  360. 0
  CONSTRAINT::    angle_B:  126.6  2.0   150.0  360. 0
  CONSTRAINT::  torsion_A:   96.2  2.0   150.0  360. 0
  CONSTRAINT:: torsion_AB:  51.4  2.0  150.0  180. 0
  CONSTRAINT::  torsion_B:  176.8  2.0  150.0  360. 0

  ALGORITHM_INFO:: match
   MAX_DUNBRACK_ENERGY 100.0 
  ALGORITHM_INFO::END
CST::END

VARIABLE_CST::END


#block 3 for His coordinated to Zn

VARIABLE_CST::BEGIN
# HIS coordination
CST::BEGIN

  TEMPLATE::   ATOM_MAP: 1 atom_name: ZN1 O1 C1
  TEMPLATE::   ATOM_MAP: 1 residue3:  BRM

  TEMPLATE::   ATOM_MAP: 2 atom_type: Nhis
  TEMPLATE::   ATOM_MAP: 2 residue3: HIS

  CONSTRAINT:: distanceAB:   2.01   0.02   150.  1    0
  CONSTRAINT::    angle_A:   121.0  2.0   150.0  360. 0
  CONSTRAINT::    angle_B:   127.8  2.0   150.0  360. 0
  CONSTRAINT::  torsion_A:  -37.0  2.0   150.0  360. 0
  CONSTRAINT:: torsion_AB:   76.4  2.0  150.0  180. 0
  CONSTRAINT::  torsion_B:   -177.9  2.0  150.0  360. 0

  ALGORITHM_INFO:: match
   MAX_DUNBRACK_ENERGY 100.0 
  ALGORITHM_INFO::END
CST::END

VARIABLE_CST::END